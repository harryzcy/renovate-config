{
  "extends": [
    "config:best-practices",
    ":pinDependencies",
    ":disableDependencyDashboard",
    ":automergeMinor",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:minimumReleaseAgeNpm",
    ":disableRateLimiting"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "labels": [
      "dependencies",
      "skip-changelog"
    ]
  },
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "major": {
    "automerge": false
  },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchDatasources": [
        "golang-version",
        "node-version"
      ],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/go-versions",
        "actions/node-versions"
      ],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "golang-version"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "golang.org/x/**"
      ],
      "groupName": "golang.org/x"
    },
    {
      "matchDatasources": [
        "github-digest"
      ],
      "versioning": "exact",
      "extractVersion": null
    },
    {
      "matchDatasources": [
        "github-digest"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "harryzcy/github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": "6 hours",
      "automerge": true
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths",
    "npmDedupe"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ]
  }
}
